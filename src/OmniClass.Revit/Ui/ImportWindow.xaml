<Window x:Class="OmniClass.Revit.Ui.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import rooms — names and OmniClass"
        Height="640" Width="1100"
        MinHeight="420" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="#F5F6F8">
  <DockPanel Margin="16">
    <TextBlock x:Name="SummaryText" DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,12"/>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Check all writable" Padding="12,6" Margin="0,0,8,0" Click="CheckWritable_OnClick"/>
      <Button Content="Uncheck all" Padding="12,6" Margin="0,0,8,0" Click="UncheckAll_OnClick"/>
      <Button Content="Cancel" Padding="16,6" Margin="0,0,8,0" IsCancel="True" Click="Cancel_OnClick"/>
      <Button Content="Apply checked" Padding="16,6" IsDefault="True" Click="Apply_OnClick"/>
    </StackPanel>

    <DataGrid x:Name="Grid"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              IsReadOnly="False"
              HeadersVisibility="Column"
              GridLinesVisibility="Horizontal"
              RowHeaderWidth="0"
              SelectionMode="Extended"
              EnableRowVirtualization="True"
              FrozenColumnCount="1">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Header="Apply" Binding="{Binding Apply, UpdateSourceTrigger=PropertyChanged}"
                                IsReadOnly="False" Width="56"/>
        <DataGridTextColumn Header="Mark" Binding="{Binding RoomNumber}" IsReadOnly="True" Width="80"/>
        <DataGridTextColumn Header="Current Name" Binding="{Binding CurrentName}" IsReadOnly="True" Width="150"/>
        <DataGridTextColumn Header="Import Name" Binding="{Binding ImportName}" IsReadOnly="True" Width="150"/>
        <DataGridTextColumn Header="OmniClass Number" Binding="{Binding OmniClassNumber}" IsReadOnly="True" Width="140"/>
        <DataGridTextColumn Header="OmniClass Name" Binding="{Binding OmniClassName}" IsReadOnly="True" Width="160"/>
        <DataGridTextColumn Header="Match" Binding="{Binding Match}" IsReadOnly="True" Width="80"/>
        <DataGridTextColumn Header="Note" Binding="{Binding Note}" IsReadOnly="True" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
