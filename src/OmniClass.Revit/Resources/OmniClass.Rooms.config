# OmniClass room classification settings.
# Lives next to OmniClass.Revit.dll. Blank values fall back to the defaults below.
# Point 'dictionary' at a network share so the whole office classifies the same way.

# The alias dictionary. Relative paths resolve against this file's folder.
dictionary = data\room_aliases.csv

# Shared parameters written onto rooms. These must be shared (not project)
# parameters or they will not schedule or survive IFC and ODBC export.
numberParameter = OmniClass Number
titleParameter = OmniClass Title

# Shared parameter file to read the definitions from. Leave blank to have the
# add-in create one next to the dictionary with fixed GUIDs, which is what keeps
# the parameters consistent from project to project.
sharedParameterFile =

# Replace values on rooms that are already classified.
overwriteExisting = false
