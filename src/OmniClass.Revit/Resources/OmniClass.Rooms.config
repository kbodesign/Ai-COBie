# OmniClass room classification settings.
# Lives next to OmniClass.Revit.dll. Blank values fall back to the defaults below.
# Point 'dictionary' at a network share so the whole office classifies the same way.

# The alias dictionary. Relative paths resolve against this file's folder.
# Columns: A = Number, B = Name, C+ = room name options.
dictionary = data\room_aliases.csv

# Parameters written onto each classified room. These names match the Arch template.
# If they already exist they are reused; they are only created when missing.
numberParameter = Classification.Space.Number
titleParameter = Classification.Space.Description
categoryParameter = COBie.Space.Category

# Shared parameter file used only when a parameter above is missing from the project.
sharedParameterFile =

# Replace values on rooms that are already classified. Leave false so a second
# run skips populated rooms instead of overwriting or erroring.
overwriteExisting = false

# Do not create Classification/COBie parameters. They already exist in the Arch
# template; creating them again collides with GUIDs already in the shared file.
createMissingParameters = false

# Room key schedule filled by the Key Schedule button. Run it once in the Arch
# template so new projects already have the Room Type dropdown. If a Rooms key
# schedule already exists, it is reused instead of creating a second one.
keyScheduleName = Room Type
keyScheduleParameter = Room Type
