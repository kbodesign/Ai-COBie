<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Revit 2023-2024 run on .NET Framework 4.8; Revit 2025+ run on .NET 8.
         The API surface used here is the same on both, so one source tree covers all four. -->
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <LangVersion>9.0</LangVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>OmniClass.Revit</RootNamespace>
    <AssemblyName>OmniClass.Revit</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Lets the add-in be built and reviewed on a non-Windows machine. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OmniClass.Core\OmniClass.Core.csproj" />
  </ItemGroup>

  <!-- Compile against the oldest API in each band so the output loads on the newer ones too.
       ExcludeAssets=runtime keeps RevitAPI.dll out of the add-in folder. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2023.*" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2023.*" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2025.*" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2025.*" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Resources\OmniClass.Rooms.config" Link="OmniClass.Rooms.config" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\room_aliases.csv" Link="data\room_aliases.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\install\OmniClass.Rooms.addin" Link="OmniClass.Rooms.addin" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Resources\classify16.png" />
    <EmbeddedResource Include="Resources\classify32.png" />
    <EmbeddedResource Include="Resources\export16.png" />
    <EmbeddedResource Include="Resources\export32.png" />
    <EmbeddedResource Include="Resources\import16.png" />
    <EmbeddedResource Include="Resources\import32.png" />
    <EmbeddedResource Include="Resources\key16.png" />
    <EmbeddedResource Include="Resources\key32.png" />
  </ItemGroup>

  <Target Name="RemoveRevitApiFromOutput" AfterTargets="Build">
    <ItemGroup>
      <_RevitApi Include="$(OutputPath)RevitAPI.dll;$(OutputPath)RevitAPIUI.dll;$(OutputPath)AdWindows.dll" />
    </ItemGroup>
    <Delete Files="@(_RevitApi)" ContinueOnError="true" />
  </Target>

</Project>
